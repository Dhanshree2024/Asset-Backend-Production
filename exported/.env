# ─── Cookie policy (src/common/config/cookie.config.ts) ───────────────────
# COOKIE_SAMESITE : lax | strict | none.
#   Use 'none' ONLY when the frontend and this API are on different
#   registrable domains. 'none' forces Secure on, so both must be HTTPS.
# COOKIE_SECURE   : true | false. Defaults to true when NODE_ENV=production.
# COOKIE_DOMAIN   : leave empty for host-only cookies (recommended).
# COOKIE_PATH     : defaults to /
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_PATH=/
AUTH_COOKIE_REMEMBER_MAX_AGE_MS=2592000000

DISCOVERY_AGENT_TOKEN=aa0d23e802ac7be2361cbf08b82dbdcfb75d23a46dae6cc4
# --- Agent Discovery Phase 2 (see PHASE2_COMPLETION.pdf) ---
DISCOVERY_CREDENTIAL_KEY=AgentDiscoveryFeature1   
DISCOVERY_LDAPS_ALLOW_SELF_SIGNED=true              
# DISCOVERY_PERMISSIONS_ENFORCE=true    

# ── Agent Discovery — Phase 3 (software packages / deployments) ─────────────
# Where uploaded installers are stored. Must be writable by the backend process
# and OUTSIDE the web root. Default if omitted: <backend working dir>/storage/discovery-packages
# Use a volume with enough space for installers (a few GB). Windows example: D:\asset-packages
DISCOVERY_PACKAGE_DIR=/var/lib/asset-management/discovery-packages
 
# Largest single installer upload, in MB. Default 2048.
DISCOVERY_PACKAGE_MAX_MB=2048
 
# Secret that signs the one-hour agent download tokens. OPTIONAL — if omitted the
# backend uses DISCOVERY_CREDENTIAL_KEY (already mandatory since Phase 2).
# Set it only if you want token signing rotated independently of credential encryption.
# DISCOVERY_PACKAGE_TOKEN_SECRET=<random 32+ chars>

